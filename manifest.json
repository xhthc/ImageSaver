{
  "manifest_version": 3,
  "name": "MediaLatch",
  "version": "2.5.2",
  "description": "Save available original images, videos and GIFs, with parallel downloads, custom folders and local statistics.",
  "homepage_url": "https://github.com/xhthc/MediaLatch",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MediaLatch",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    },
    "default_popup": "popup/quick.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/content_notifications.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "content/content_context_target.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "lib/i18n.js",
        "content/content_x.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.reddit.com/*",
        "https://reddit.com/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "lib/i18n.js",
        "content/content_reddit.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.redgifs.com/*",
        "https://redgifs.com/*",
        "https://*.reddit.com/*",
        "https://reddit.com/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "lib/i18n.js",
        "content/content_redgifs.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.donmai.us/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "content/content_booru.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "lib/i18n.js",
        "content/content_instagram.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "lib/i18n.js",
        "content/content_tiktok.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "lib/debug_journal.js",
        "lib/i18n.js",
        "content/content_youtube.js"
      ],
      "run_at": "document_start"
    }
  ]
}
