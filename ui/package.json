{
  "name": "image-saver-ui",
  "private": true,
  "version": "0.0.0",
  "description": "UI-only development build of the MediaLatch extension pages. Output is committed to ../popup so the extension loads without a build.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:built": "node scripts/check-built.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "preview": "node scripts/preview-server.mjs",
    "test:render": "node ../test_ui_render.js"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
